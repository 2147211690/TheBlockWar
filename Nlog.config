<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" 
      internalLogFile="c:\temp\nlog-internal.log">
    <!-- 注册自定义 Target -->
    <extensions>
        <add assembly="TheBlockWar"/> <!-- 你的程序集名称 -->
    </extensions>
    <!-- 输出目标 -->
    <targets>
        <!-- 控制台 -->
        <target name="console" xsi:type="Console"
                layout="${time} [${counter}] [${callsite}] [${uppercase:${level}}] ${message} ${exception:format=ToString}"/>
        
        <target name="godot" xsi:type="Godot"
                layout="${time} [${counter}] [${callsite}] [${uppercase:${level}}] ☀️ ${message} ${exception:format=ToString}"/>
        <!-- 文件 -->
        <target name="file" xsi:type="File"
                fileName="${basedir}/logs/${appName}-${shortdate}.log"
                layout="${longdate} [${uppercase:${level}}] ${callsite}(${callsite-linenumber}) - ${message} ${exception:format=ToString}"
                maxArchiveFiles="999"
                archiveAboveSize="102400"
                archiveEvery="Day"
                createDirs="true"
                encoding="UTF-8"/>
    </targets>

    <!-- 日志规则 -->
    <rules>
        <logger name="*" minlevel="Debug" writeTo="godot"/>
    </rules>
</nlog>