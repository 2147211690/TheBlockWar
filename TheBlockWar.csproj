<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>default</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--<PublishAOT>true</PublishAOT>-->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GDTask" Version="2.0.0" />
    <PackageReference Include="GodotSharp.SourceGenerators" Version="2.6.0" />
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="NLog" Version="6.1.1" />
    <PackageReference Include="SoftUni.Wintellect.PowerCollections" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- 防止裁剪必要的程序集 -->
    <TrimmerRootAssembly Include="GodotSharp" />
    <TrimmerRootAssembly Include="$(TargetName)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="开发规范\添加新模拟操作步骤的规范流程.md" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Scripts\Games\Tiles\" />
    <Folder Include="Scripts\Games\Units\" />
  </ItemGroup>
</Project>